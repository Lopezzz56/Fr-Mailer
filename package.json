{
  "name": "fr-mailer",
  "version": "0.1.0",
  "private": true,
  "description": "FocusRealm Mail Merge",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --strictPort",
    "typecheck": "npx tsc -p tsconfig.server.json --noEmit && npx tsc -p tsconfig.client.json --noEmit",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "build:server": "npx tsc -p tsconfig.server.json",
    "build:client": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "start": "node dist/server/server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed-demo": "tsx src/server/scripts/seed-demo-users.ts",
    "test": "vitest run",
    "test:integration": "node tests/run-integration.mjs",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "user:create": "tsx src/server/scripts/create-user.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/functions": "^3.9.11",
    "csv-parse": "^7.0.3",
    "express": "^4.19.2",
    "imapflow": "^1.0.191",
    "lucide-react": "^1.61.0",
    "mailparser": "^3.7.4",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^5.8.8",
    "typescript": "^5.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.10",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv": "^18.0.9",
    "postcss": "^8.4.31",
    "prettier": "^3.3.3",
    "prisma": "^5.18.0",
    "smtp-server": "^3.13.6",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.16.2",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "write-excel-file": "^4.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
