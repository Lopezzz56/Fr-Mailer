# FocusRealm Mail Merge — environment configuration
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3010
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Database (use 127.0.0.1, not localhost: WSL can claim [::1]:5432 on Windows)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/fr_mailer"
# On Supabase:
# Use Session Pooler on port 5432 (supports IPv4, migrations, and concurrent queries):
# DATABASE_URL="postgresql://postgres.[REF]:[PASS]@[REGION].pooler.supabase.com:5432/postgres?connection_limit=15&pool_timeout=30&connect_timeout=15"
# DIRECT_URL="postgresql://postgres.[REF]:[PASS]@[REGION].pooler.supabase.com:5432/postgres?connection_limit=15&pool_timeout=30&connect_timeout=15"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/fr_mailer"

# Supabase API & Auth Keys (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Links in emails (unsubscribe, team invites)
# PUBLIC_URL must be reachable by recipients in production (e.g. https://fr-mailer.vercel.app).
# In local development it defaults to http://localhost:5173 if not set.
# ---------------------------------------------------------------------------
PUBLIC_URL=https://fr-mailer.vercel.app
# Generate with: openssl rand -hex 32
APP_SECRET=

# ---------------------------------------------------------------------------
# SpaceMail SMTP (sending). 465 = implicit TLS (SMTP_SECURE=true); 587 = STARTTLS (false)
# ---------------------------------------------------------------------------
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=
SMTP_FROM_EMAIL=you@yourdomain.com
SMTP_FROM_NAME=FocusRealm

# Approved campaigns only send to real recipients when this is true
ALLOW_LIVE_SENDING=false
# Mailbox-wide cap per rolling 24 hours (stay under your SpaceMail plan's limit)
DAILY_SEND_LIMIT=300

# ---------------------------------------------------------------------------
# SpaceMail IMAP (read-only bounce & reply detection)
# ---------------------------------------------------------------------------
IMAP_HOST=mail.spacemail.com
IMAP_PORT=993
IMAP_USER=you@yourdomain.com
IMAP_PASS=
IMAP_POLL_ENABLED=false
IMAP_POLL_INTERVAL_SECONDS=120

# ---------------------------------------------------------------------------
# Serverless (Vercel) only: authorizes /api/internal/tick, which runs sending bursts.
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional: "Write it for me" drafts templates with Google Gemini (https://aistudio.google.com/apikey).
# Sent to Google: the brief, an optional example email, and merge-field names with coverage %.
# Contact records are never sent. Leave empty to offer the built-in starter templates only.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
